{
  "name": "@dsmm/dsmm",
  "version": "0.3.3",
  "description": "Native Deepwork roles, routing, profiles, and permission controls for DeepSeek Harness.",
  "author": "Hugefiver",
  "license": "LicenseRef-AAAPL",
  "repository": "https://github.com/hugefiver/dsmm",
  "homepage": "https://github.com/hugefiver/dsmm#readme",
  "bugs": "https://github.com/hugefiver/dsmm/issues",
  "packageManager": "pnpm@11.9.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepwork",
    "agentic-workflows",
    "cordis"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./managed-settings": {
      "types": "./lib/managed-settings.d.ts",
      "default": "./lib/managed-settings.js"
    },
    "./llm-runtime": {
      "types": "./lib/llm-runtime.d.ts",
      "default": "./lib/llm-runtime.js"
    },
    "./permission-bash": {
      "types": "./lib/permission-bash.d.ts",
      "default": "./lib/permission-bash.js"
    },
    "./permission-pwsh": {
      "types": "./lib/permission-pwsh.d.ts",
      "default": "./lib/permission-pwsh.js"
    },
    "./permission-fs": {
      "types": "./lib/permission-fs.d.ts",
      "default": "./lib/permission-fs.js"
    },
    "./permission-fs-search": {
      "types": "./lib/permission-fs-search.d.ts",
      "default": "./lib/permission-fs-search.js"
    },
    "./permission-web": {
      "types": "./lib/permission-web.d.ts",
      "default": "./lib/permission-web.js"
    },
    "./web-fetch-fakeip": {
      "types": "./lib/web-fetch-fakeip.d.ts",
      "default": "./lib/web-fetch-fakeip.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "!lib/legacy-read-host.js",
    "!lib/legacy-read-host.d.ts",
    "!lib/legacy-read-contracts.js",
    "!lib/legacy-read-contracts.d.ts",
    "!lib/legacy-read-composition.js",
    "!lib/legacy-read-composition.d.ts",
    "!lib/legacy-read-integration.js",
    "!lib/legacy-read-integration.d.ts",
    "!lib/legacy-read-proxy.js",
    "!lib/legacy-read-proxy.d.ts",
    "!lib/legacy-child-policy.js",
    "!lib/legacy-child-policy.d.ts",
    "locale/*.json",
    "agent-presets",
    "docs/agent-presets.md",
    "docs/compatibility.md",
    "docs/design.md",
    "docs/deferred-native-approval-risk.md",
    "docs/lsp.md",
    "docs/maintenance.md",
    "docs/model-routing.md",
    "docs/native-permissions.md",
    "docs/profiles.md",
    "docs/releasing.md",
    "docs/roadmap.md",
    "docs/runtime-recovery.md",
    "docs/safety-guards.md",
    "docs/settings-status.md",
    "docs/web-fetch-fakeip.md",
    "patches",
    "prompts",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/materialize-frontend.mjs --check && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "generate:roles": "node scripts/generate-role-assets.mjs",
    "check:frontend": "node scripts/materialize-frontend.mjs --check",
    "check:roles": "node scripts/generate-role-assets.mjs --check",
    "sync:frontend": "node scripts/materialize-frontend.mjs --sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "pnpm run build && tsc -p tsconfig.test.json --noEmit",
    "test:run": "node --test --experimental-strip-types --import ./test/prompt-source-loader.mjs --test-concurrency=1 test/*.test.ts",
    "test": "pnpm run build && pnpm run test:run"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
